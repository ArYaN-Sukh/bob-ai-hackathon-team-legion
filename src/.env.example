# TrialGuard — Environment Variables
# Copy this file to .env and fill in your values
# The .env file is gitignored — never commit real credentials

# ── IBM watsonx.ai ────────────────────────────────────────────────────────────
# Get these from your IBM Cloud account → watsonx.ai → Project settings
WATSONX_API_KEY=your_ibm_cloud_api_key_here
WATSONX_PROJECT_ID=your_watsonx_project_id_here
WATSONX_URL=https://us-south.ml.cloud.ibm.com

# ── NVIDIA Nemotron (Ask Bob) ─────────────────────────────────────────────────
# Get NVIDIA API key from https://build.nvidia.com/
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# ── Backend ───────────────────────────────────────────────────────────────────
APP_PORT=8000
APP_ENV=development
DATABASE_PATH=src/backend/data/trialguard.db
# Leave DATABASE_URL empty for local SQLite. In Vercel, set this to the
# managed Vercel Postgres/Neon SQLAlchemy-compatible PostgreSQL connection URL.
DATABASE_URL=
PROTOCOL_PATH=src/backend/data/protocol.json

# ── Frontend (Vite) ───────────────────────────────────────────────────────────
# API base URL for frontend. Defaults to /api for same-origin hosting.
# When serving React from FastAPI, the frontend uses same-origin requests to /api
# Only set this if running frontend separately from backend (not recommended).
VITE_API_BASE_URL=/api
